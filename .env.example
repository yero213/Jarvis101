GEMINI_API_KEY=plak-hier-je-key-uit-Google-AI-Studio
# Optioneel:
# GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
# GEMINI_VOICE=Charon

# Google OAuth (Gmail & Drive) — download credentials.json van Google Cloud Console
GOOGLE_CREDENTIALS=credentials.json

# --- Home Assistant & Umbrel (optioneel) ---
# Home Assistant draaiend op je Umbrel:
HA_URL=http://umbrel.local:8123
HA_TOKEN=jouw_lange_lived_token_uit_home_assistant

# Umbrel SSH (optioneel, voor directe commando's):
UMBREL_HOST=umbrel.local
UMBREL_USER=umbrel
UMBREL_SSH_KEY=C:\Users\jouwnaam\.ssh\id_ed25519
# UMBREL_PASSWORD=jouw_umbrel_wachtwoord   # alleen als je geen SSH-sleutel gebruikt
